<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane fx:id="mainPane" prefHeight="832.0" prefWidth="1280.0" style="-fx-background-color: #0b0f19;" stylesheets="@../style/addBankCard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.car_rental_sys.controllers.AddBankCardPageController">
    <!-- Top Navigation Bar -->
    <Pane prefHeight="50.0" prefWidth="1280.0" style="-fx-background-color: transparent;">
        <fx:include source="navigationBarShort.fxml" />
    </Pane>

    <!-- Top Card Showcase (Neatly Centered) -->
    <ImageView fx:id="cardImage1" fitHeight="120.0" fitWidth="190.0" layoutX="320.0" layoutY="90.0" opacity="0.6" pickOnBounds="true" preserveRatio="true">
        <Image url="@../image/UI/paypal.png" />
    </ImageView>
    <ImageView fx:id="cardImage3" fitHeight="100.0" fitWidth="160.0" layoutX="920.0" layoutY="100.0" opacity="0.4" pickOnBounds="true" preserveRatio="true">
        <Image url="@../image/UI/tng.png" />
    </ImageView>
    <ImageView fx:id="cardImage2" fitHeight="120.0" fitWidth="190.0" layoutX="770.0" layoutY="90.0" opacity="0.6" pickOnBounds="true" preserveRatio="true">
        <Image url="@../image/UI/visaWhite.png" />
    </ImageView>
    <ImageView fx:id="cardImageMain" fitHeight="165.0" fitWidth="260.0" layoutX="510.0" layoutY="70.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@../image/UI/MasterCardBlack.png" />
    </ImageView>

    <!-- Back Button -->
    <ImageView fx:id="backBtn" fitHeight="42.0" fitWidth="42.0" layoutX="1200.0" layoutY="65.0" pickOnBounds="true" preserveRatio="true" styleClass="hand">
        <Image url="@../image/UI/back-blue.png" />
    </ImageView>

    <!-- Interactive Card Form (Cleanly Positioned and Scrollable) -->
    <ScrollPane fx:id="testScrollPane" hbarPolicy="NEVER" layoutX="230.0" layoutY="245.0" prefHeight="570.0" prefWidth="820.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
        <VBox prefWidth="800.0" spacing="14.0" style="-fx-background-color: transparent; -fx-padding: 0 10 30 10;">
            <!-- Header -->
            <Pane prefHeight="50.0" prefWidth="800.0" style="-fx-border-style: hidden hidden solid hidden; -fx-border-color: #1e293b;">
                <Label layoutX="6.0" layoutY="6.0" text="Add Your Payment Card" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </Pane>

            <!-- Card Type Radios -->
            <Pane prefHeight="70.0" prefWidth="800.0" style="-fx-background-color: #151c2c; -fx-background-radius: 12;">
                <Label layoutX="16.0" layoutY="24.0" text="Card Type:" textFill="#cbd5e1">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Pane fx:id="typeMastercard" layoutX="110.0" layoutY="12.0" onMouseClicked="#cardRadioClick" prefHeight="45.0" prefWidth="150.0" style="-fx-border-color: #334155; -fx-background-color: #1e293b; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;">
                    <RadioButton fx:id="mastercardRadio" layoutX="18.0" layoutY="13.0" mnemonicParsing="false" onMouseClicked="#cardRadioClick" style="-fx-text-fill: white;" text="Mastercard">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </RadioButton>
                </Pane>
                <Pane fx:id="visaType" layoutX="280.0" layoutY="12.0" onMouseClicked="#cardRadioClick" prefHeight="45.0" prefWidth="150.0" style="-fx-border-color: #334155; -fx-background-color: #1e293b; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;">
                    <RadioButton fx:id="visaRadio" layoutX="22.0" layoutY="13.0" mnemonicParsing="false" onMouseClicked="#cardRadioClick" style="-fx-text-fill: white;" text="Visa">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </RadioButton>
                </Pane>
                <Pane fx:id="paypalType" layoutX="450.0" layoutY="12.0" onMouseClicked="#cardRadioClick" prefHeight="45.0" prefWidth="150.0" style="-fx-border-color: #334155; -fx-background-color: #1e293b; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;">
                    <RadioButton fx:id="paypalRadio" layoutX="22.0" layoutY="13.0" mnemonicParsing="false" onMouseClicked="#cardRadioClick" style="-fx-text-fill: white;" text="PayPal">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </RadioButton>
                </Pane>
                <Pane fx:id="tngType" layoutX="620.0" layoutY="12.0" onMouseClicked="#cardRadioClick" prefHeight="45.0" prefWidth="150.0" style="-fx-border-color: #334155; -fx-background-color: #1e293b; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;">
                    <RadioButton fx:id="tngRadio" layoutX="22.0" layoutY="13.0" mnemonicParsing="false" onMouseClicked="#cardRadioClick" style="-fx-text-fill: white;" text="Touch 'n Go">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </RadioButton>
                </Pane>
            </Pane>

            <!-- Card Custom Label -->
            <Pane prefHeight="65.0" prefWidth="800.0" style="-fx-background-color: #151c2c; -fx-background-radius: 12;">
                <Label layoutX="16.0" layoutY="22.0" text="Card Label / Name" textFill="#cbd5e1">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCardName" layoutX="240.0" layoutY="12.0" prefHeight="40.0" prefWidth="450.0" promptText="e.g. Primary Executive Card" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12;" />
            </Pane>

            <!-- Card Details (Bank, Holder, Valid, Number) -->
            <Pane prefHeight="240.0" prefWidth="800.0" style="-fx-background-color: #151c2c; -fx-background-radius: 12;">
                <Label layoutX="16.0" layoutY="20.0" text="Bank Name" textFill="#cbd5e1">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="banksComboBox" layoutX="240.0" layoutY="12.0" prefHeight="40.0" prefWidth="450.0" style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;" />

                <Label layoutX="16.0" layoutY="74.0" text="Cardholder Name" textFill="#cbd5e1">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCardHolder" layoutX="240.0" layoutY="66.0" prefHeight="40.0" prefWidth="450.0" promptText="Cardholder Full Name" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12;" />

                <Label layoutX="16.0" layoutY="128.0" text="Card Number (16 digits)" textFill="#cbd5e1">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtCardNumber" layoutX="240.0" layoutY="120.0" prefHeight="40.0" prefWidth="450.0" promptText="5412 7512 3412 6742" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12 0 12;" />

                <Label layoutX="16.0" layoutY="182.0" text="Valid Date (MM / YY)" textFill="#cbd5e1">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER_LEFT" layoutX="240.0" layoutY="174.0" spacing="10.0">
                    <TextField fx:id="txtValidMonth" alignment="CENTER" prefHeight="40.0" prefWidth="80.0" promptText="09" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;" />
                    <Label text="/" textFill="#64748b">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>
                    <TextField fx:id="txtValidDate" alignment="CENTER" prefHeight="40.0" prefWidth="80.0" promptText="28" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;" />
                </HBox>
            </Pane>

            <!-- Billing Address & Preference -->
            <Pane prefHeight="130.0" prefWidth="800.0" style="-fx-background-color: #151c2c; -fx-background-radius: 12;">
                <Label layoutX="16.0" layoutY="20.0" text="Billing Address" textFill="#cbd5e1">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextArea fx:id="billTextArea" layoutX="240.0" layoutY="12.0" prefHeight="70.0" prefWidth="450.0" promptText="Billing Address &amp; Zip Code" style="-fx-control-inner-background: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;" />
                <CheckBox fx:id="sendMeCheckBox" layoutX="240.0" layoutY="95.0" mnemonicParsing="false" selected="true" text="Set as primary payment method in wallet" textFill="#94a3b8">
                    <font>
                        <Font size="13.0" />
                    </font>
                </CheckBox>
            </Pane>

            <!-- Action Button Row -->
            <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="800.0" spacing="16.0">
                <Button onAction="#handleCancel" prefHeight="44.0" prefWidth="140.0" style="-fx-background-color: #1e293b; -fx-text-fill: #94a3b8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14.0; -fx-cursor: hand;" text="Cancel" />
                <Button fx:id="addCardButton" onAction="#handleAddCardAction" prefHeight="44.0" prefWidth="220.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 15.0; -fx-font-weight: bold; -fx-cursor: hand;" text="Save &amp; Link Card" />
            </HBox>
        </VBox>
    </ScrollPane>
</Pane>
