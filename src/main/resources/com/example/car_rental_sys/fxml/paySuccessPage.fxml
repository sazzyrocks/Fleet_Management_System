<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.car_rental_sys.controllers.PaySuccessPageController"
           prefHeight="832.0" prefWidth="1280.0" fx:id="mainPane"
           style="-fx-background-color: #050811;">

    <!-- Native JavaFX MediaView for full 1080p 60fps video with audio -->
    <MediaView fx:id="mediaView" fitWidth="1280.0" fitHeight="832.0" preserveRatio="true" />

    <!-- Overlay Celebration Card (shown when video finishes, on click, or as fallback) -->
    <VBox fx:id="celebrationCard" alignment="CENTER" spacing="16.0" visible="false"
          style="-fx-background-color: rgba(15, 23, 42, 0.94); -fx-background-radius: 20px; -fx-padding: 36 48 36 48; -fx-border-color: rgba(74, 222, 128, 0.45); -fx-border-radius: 20px; -fx-border-width: 1.5px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.85), 35, 0, 0, 12); -fx-max-width: 520px; -fx-alignment: CENTER;">
        <ImageView fx:id="successIcon" fitWidth="80.0" fitHeight="80.0" preserveRatio="true">
            <image>
                <Image url="@../html/paySuccess/success.png" />
            </image>
        </ImageView>
        <Label text="Payment Completed!"
               style="-fx-text-fill: #4ade80; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', sans-serif;" />
        <Label fx:id="orderTitleLabel" text="Your supercar reservation is confirmed!"
               wrapText="true" alignment="CENTER" textAlignment="CENTER"
               style="-fx-text-fill: #f1f5f9; -fx-font-size: 16px; -fx-font-weight: bold;" />
        <Label fx:id="orderSubtitleLabel" text="Driver dispatch is in progress. Check live telemetry &amp; route status."
               wrapText="true" alignment="CENTER" textAlignment="CENTER"
               style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
        <Button fx:id="btnViewOrders" text="View My Orders →" onAction="#handleViewOrders"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 36 12 36; -fx-background-radius: 10px; -fx-cursor: hand;" />
    </VBox>

    <!-- Top floating skip button & instructions -->
    <AnchorPane pickOnBounds="false" prefHeight="832.0" prefWidth="1280.0">
        <Button fx:id="btnSkip" text="Skip to Orders ➔" onAction="#handleViewOrders"
                AnchorPane.topAnchor="24.0" AnchorPane.rightAnchor="32.0"
                style="-fx-background-color: rgba(30, 41, 59, 0.85); -fx-text-fill: #e2e8f0; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8 18 8 18; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Label text="Press SPACE or ESC to skip" AnchorPane.bottomAnchor="18.0" AnchorPane.rightAnchor="24.0"
               style="-fx-text-fill: rgba(255, 255, 255, 0.45); -fx-font-size: 12px;" />
    </AnchorPane>
</StackPane>
